pipeline {
    agent any

    environment {
        // External tool URLs and credentials
        SONARQUBE_URL = 'http://localhost:9000'
        SONARQUBE_TOKEN = credentials('sonar-token')

        NEXUS_URL = 'http://localhost:8081'
        NEXUS_REPO = 'maven-snapshots'
        NEXUS_CREDENTIALS = credentials('nexus_cred')

        TOMCAT_URL = 'http://localhost:9090'
        TOMCAT_CREDENTIALS = credentials('tomcat_cred')
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Checking out code from GitHub..."
                git branch: 'feature/EXE-10098',
                    url: 'https://github.com/dgp032023/dgp_code_lab.git'
            }
        }

        stage('Build with Maven') {
            steps {
                echo "Running Maven clean and package..."
                bat "mvn -f mywebapp/pom.xml clean package -DskipTests"
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "Running SonarQube code analysis..."
                withSonarQubeEnv('sonar-server') {
                    bat """
                        mvn -f mywebapp/pom.xml sonar:sonar ^
                          -Dsonar.projectKey=Test3 ^
                          -Dsonar.projectName=Test3 ^
                          -Dsonar.projectVersion=1.0 ^
                          -Dsonar.sources=mywebapp/src ^
                          -Dsonar.java.binaries=mywebapp/target ^
                          -Dsonar.host.url=${SONARQUBE_URL} ^
                          -Dsonar.login=${SONARQUBE_TOKEN}
                    """
                }
            }
        }

        stage('Upload Artifact to Nexus') {
            steps {
                echo "Uploading WAR file to Nexus repository..."
                nexusArtifactUploader(
                    nexusVersion: 'nexus3',
                    protocol: 'http',
                    nexusUrl: 'localhost:8081',
                    groupId: 'com.example.webapp',
                    version: '1.0-SNAPSHOT',
                    repository: "${NEXUS_REPO}",
                    credentialsId: 'nexus_cred',
                    artifacts: [[
                        artifactId: 'mywebapp',
                        classifier: '',
                        file: 'mywebapp/target/mywebapp.war',
                        type: 'war'
                    ]]
                )
            }
        }

        stage('Deploy to Tomcat') {
            steps {
                echo "Deploying WAR to Apache Tomcat..."
                deploy adapters: [
                    tomcat9(
                        credentialsId: 'tomcat_cred',
                        path: '/mywebapp',
                        url: "${TOMCAT_URL}/manager/text"
                    )
                ],
                contextPath: '/mywebapp',
                war: 'mywebapp/target/mywebapp.war'
            }
        }
    }

    post {
        success {
            echo '✅ Build, Analysis, Upload, and Deployment Completed Successfully!'
        }
        failure {
            echo '❌ Build Failed — Check console logs.'
        }
    }
}
